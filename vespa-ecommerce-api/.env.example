# Database
DATABASE_URL="postgresql://user:password@localhost:5432/vespapart_ecommerce?schema=public"

# JWT Auth
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Frontend & Admin URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3003

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false

# Payment Gateway (Xendit)
XENDIT_API_KEY="xnd_development_xxxxxxxxxxxxxxxxxxxxxxxxxxx"
XENDIT_WEBHOOK_TOKEN="your-webhook-verification-token"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Logistics / Shipping (Biteship & Rajaongkir)
BITESHIP_API_KEY=your_biteship_api_key
BITESHIP_SECRET_KEY=your_biteship_secret_key
RAJAONGKIR_API_KEY=your_rajaongkir_api_key

# Accurate ERP Integration
ACCURATE_CLIENT_ID="your_accurate_client_id"
ACCURATE_CLIENT_SECRET="your_accurate_client_secret"
ACCURATE_REDIRECT_URI="http://localhost:3001/accurate/callback"
ACCURATE_AUTH_URL="https://account.accurate.id/oauth/authorize"
ACCURATE_TOKEN_URL="https://account.accurate.id/oauth/token"
ACCURATE_API_BASE_URL="https://public.accurate.id"
ACCURATE_DEFAULT_PRICE_CATEGORY_ID=50
ACCURATE_RESELLER_CATEGORY_ID=100

# Email Notification (Gmail Nodemailer / SES)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-google-app-password"
EMAIL_SENDER_NAME="VespaParts"
EMAIL_SENDER_ADDRESS="your-email@gmail.com"